  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Toynopoly is an add-on for the rc car racing game re-volt/RVGL.


    The
    game table consists of 6 randomly selected cars of the same category and 10 tracks.
    Everyone starts with 150 cash. Every car has a value of 20 at the beginning of
    LEVEL 1.


    level 1


    The active player picks a car / track combination.
    Everyone will drive the same car that was picked. The winner (and runner-ups,
    depending on the total number of players) will get the car added to their inventory.


    After
    each race, the price of the chosen car will randomly go up or down by +10, +7,
    +5 to -5, -7 or -10.


    The number of races played in level 1 depends on the
    match type (regular or short) and the number of players (see table below).

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: af17111b7c862414b9b0a68fc902f709, type: 2}
